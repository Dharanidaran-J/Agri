# Gemini API Key (optional for live LLM mode; offline mode works deterministically without keys)
GEMINI_API_KEY=

# Groq API Key (optional alternative)
GROQ_API_KEY=

# OpenAI API Key (optional alternative)
OPENAI_API_KEY=

# OpenWeather API Key (optional; Open-Meteo is used by default with zero key required)
OPENWEATHER_API_KEY=

# Server Configuration
PORT=5000
DEBUG=false
MAX_ITERATIONS=10
